	<Script file="main.lua"/>

	<Include file="script\script.xml"/>
	<Include file="inner\inner.xml"/>
	<Include file="links\links.xml"/>
	<Include file="items\items.xml"/>
	<Include file="document\document.xml"/>
	<Include file="campaign\campaign.xml"/>
	<Include file="cutscene\cutscene.xml"/>
	<Include file="list\list.xml"/>

	<Frame name="TRP3_ToolFrame" inherits="TRP3_MainFrameTemplate" hidden="true" movable="true" toplevel="true" frameStrata="HIGH">
		<Anchors>
			<Anchor point="CENTER" x="0" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="BkgMain" file="Interface\DialogFrame\UI-DialogBox-Background" name="$parentBkgMain">
					<TexCoords left="0" right="0.973" top="0.1" bottom="1"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="16" y="-66"/>
						<Anchor point="BOTTOMRIGHT" x="-40" y="16"/>
					</Anchors>
				</Texture>
				<Texture parentKey="BkgScroll" file="Interface\DialogFrame\UI-DialogBox-Background" name="$parentBkgScroll">
					<Size x="24" y="0"/>
					<TexCoords left="0.973" right="1" top="0.1" bottom="1"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-16" y="-66"/>
						<Anchor point="BOTTOMRIGHT" x="-16" y="16"/>
					</Anchors>
				</Texture>
				<Texture parentKey="BkgHeader" file="Interface\DialogFrame\UI-DialogBox-Background" name="$parentBkgHeader">
					<Size x="0" y="50"/>
					<TexCoords left="0" right="1" top="0" bottom="0.1"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="16" y="-16"/>
						<Anchor point="TOPRIGHT" x="-16" y="-16"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentNavBar" inherits="TRP3X_NavBarTemplate" parentKey="navBar">
				<Size x="0" y="34"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="30" y="-24"/>
					<Anchor point="TOPRIGHT" x="-30" y="-24"/>
				</Anchors>
				<Layers>
					<Layer level="BORDER" textureSubLevel="-5">
						<Texture name="$parentInsetBotLeftCorner"
								 parentKey="InsetBorderBottomLeft">
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="-3" y="-3"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetBotRightCorner"
								 parentKey="InsetBorderBottomRight">
							<Anchors>
								<Anchor point="BOTTOMRIGHT" x="3" y="-3"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetBottomBorder"
								 parentKey="InsetBorderBottom">
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeTo="$parentInsetBotLeftCorner"
										relativePoint="BOTTOMRIGHT"/>
								<Anchor point="BOTTOMRIGHT" relativeTo="$parentInsetBotRightCorner"
										relativePoint="BOTTOMLEFT"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetLeftBorder"
								 parentKey="InsetBorderLeft">
							<Anchors>
								<Anchor point="TOPLEFT" x="-3" y="0"/>
								<Anchor point="BOTTOMLEFT" relativeTo="$parentInsetBotLeftCorner"
										relativePoint="TOPLEFT"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetRightBorder"
								 parentKey="InsetBorderRight">
							<Anchors>
								<Anchor point="TOPRIGHT" x="3" y="0"/>
								<Anchor point="BOTTOMRIGHT" relativeTo="$parentInsetBotRightCorner"
										relativePoint="TOPRIGHT"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Frame>

			<Frame name="$parentList" inherits="TRP3_Tools_ListTemplate" parentKey="list">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="-45" y="24"/>
				</Anchors>
			</Frame>

			<Frame name="$parentActions" parentKey="actions" inherits="TRP3_FieldSetFrame">
				<Size x="150" y="135"/>
				<Anchors>
					<Anchor point="BOTTOM" x="0" y="24"/>
					<Anchor point="CENTER" relativePoint="CENTER" x="0" y="0"/>
				</Anchors>
				<Frames>
					<Button parentKey="save" inherits="TRP3_CommonButton" text="SAVE" name="$parentsave">
						<Anchors>
							<Anchor point="TOP" x="0" y="-25"/>
							<Anchor point="LEFT" x="18" y="0"/>
							<Anchor point="RIGHT" x="-15" y="0"/>
						</Anchors>
					</Button>
					<Button parentKey="cancel" inherits="TRP3_CommonButton" text="[[SAVE_AS]]" name="$parentcancel">
						<Anchors>
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="$parentsave" x="0" y="-8"/>
							<Anchor point="LEFT" x="18" y="0"/>
							<Anchor point="RIGHT" x="-15" y="0"/>
						</Anchors>
					</Button>
					<Button parentKey="delete" inherits="TRP3_CommonButton" text="Delete" name="$parentdelete">
						<Anchors>
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="$parentcancel" x="0" y="-8"/>
							<Anchor point="LEFT" x="18" y="0"/>
							<Anchor point="RIGHT" x="-15" y="0"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>

			<Frame name="$parentSpecificObject" parentKey="specific" inherits="TRP3_FieldSetFrame">
				<Size x="0" y="100"/>
				<Anchors>
					<Anchor point="BOTTOM" x="0" y="24"/>
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="$parentActions" x="-10" y="0"/>
					<Anchor point="LEFT" x="24" y="0"/>
				</Anchors>
				<Frames>
					<SimpleHTML parentKey="text" name="$parenttext">
						<Anchors>
							<Anchor point="TOP" x="0" y="-20"/>
							<Anchor point="BOTTOM" x="0" y="10"/>
							<Anchor point="RIGHT" x="-10" y="0"/>
							<Anchor point="LEFT" x="20" y="0"/>
						</Anchors>
						<FontString inherits="GameFontNormal"/>
					</SimpleHTML>
					<Button parentKey="id" inherits="TRP3_CommonButton" name="$parentid">
						<Anchors>
							<Anchor point="TOPRIGHT" x="-5" y="-5"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>

			<Frame name="$parentRootObject" parentKey="root" inherits="TRP3_FieldSetFrame">
				<Size x="0" y="100"/>
				<Anchors>
					<Anchor point="BOTTOM" x="0" y="24"/>
					<Anchor point="RIGHT" x="-45" y="0"/>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentActions" x="10" y="0"/>
				</Anchors>
				<Frames>
					<SimpleHTML parentKey="text" name="$parenttext">
						<Anchors>
							<Anchor point="TOP" x="0" y="-15"/>
							<Anchor point="BOTTOM" x="0" y="10"/>
							<Anchor point="RIGHT" x="-10" y="0"/>
							<Anchor point="LEFT" x="20" y="0"/>
						</Anchors>
						<FontString inherits="GameFontNormalSmall"/>
					</SimpleHTML>
					<Button parentKey="id" inherits="TRP3_CommonButton" name="$parentid">
						<Anchors>
							<Anchor point="TOPRIGHT" x="-5" y="-5"/>
						</Anchors>
					</Button>
					<Frame parentKey="select" inherits="UIDropDownMenuTemplate" enableMouse="true" name="$parentSelect">
						<Anchors>
							<Anchor point="BOTTOMRIGHT" x="7" y="4"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>

			<Frame name="$parentItem" inherits="TRP3_Tools_ItemTemplate" parentKey="item">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentRootObject" x="0" y="15"/>
				</Anchors>
			</Frame>

			<Frame name="$parentDocument" inherits="TRP3_Tools_DocumentTemplate" parentKey="document">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentRootObject" x="0" y="15"/>
				</Anchors>
			</Frame>

			<Frame name="$parentCampaign" inherits="TRP3_Tools_CampaignTemplate" parentKey="campaign">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentRootObject" x="0" y="15"/>
				</Anchors>
			</Frame>

			<Frame name="$parentQuest" inherits="TRP3_Tools_QuestTemplate" parentKey="quest">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentRootObject" x="0" y="15"/>
				</Anchors>
			</Frame>

			<Frame name="$parentStep" inherits="TRP3_Tools_StepTemplate" parentKey="step">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentRootObject" x="0" y="15"/>
				</Anchors>
			</Frame>

			<Frame name="$parentCutscene" inherits="TRP3_Tools_CutsceneTemplate" parentKey="cutscene">
				<Anchors>
					<Anchor point="TOP" relativeTo="$parentNavBar" relativePoint="BOTTOM" x="0" y="-35"/>
					<Anchor point="LEFT" x="24" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentRootObject" x="0" y="15"/>
				</Anchors>
			</Frame>

		</Frames>
		<Scripts>
			<OnLoad>
				tinsert(UISpecialFrames, self:GetName());
			</OnLoad>
		</Scripts>
	</Frame>

	<Button parentKey="Reduce" frameStrata="HIGH" parent="UIParent" hidden="true" name="$parentReduce">
		<Size x="32" y="32"/>
		<Anchors>
			<Anchor point="TOPRIGHT" relativeTo="TRP3_ToolFrame" x="-36" y="4"/>
		</Anchors>
		<NormalTexture file="Interface\Buttons\UI-Panel-HideButton-Up"/>
		<PushedTexture file="Interface\Buttons\UI-Panel-HideButton-Down"/>
		<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
		<Scripts>
			<OnClick>
				if TRP3_ToolFrame:IsVisible() then
					TRP3_ToolFrame:Hide();
				else
					TRP3_ToolFrame:Show();
				end
			</OnClick>
		</Scripts>
	</Button>

	<!-- *_*_*_*_*_*_*_*_*_*  -->
	<!--      Tutorial        -->
	<!-- *_*_*_*_*_*_*_*_*_*  -->

	<Button parentKey="tutorial" parent="TRP3_ToolFrame" name="$parenttutorial">
		<Size x="46" y="46"/>
		<Anchors>
			<Anchor point="BOTTOM" x="0" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="I" file="Interface\common\help-i" name="$parentI">
					<Size x="46" y="46"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Ring" file="Interface\Minimap\MiniMap-TrackingBorder" name="$parentRing">
					<Size x="64" y="64"/>
					<Anchors>
						<Anchor point="CENTER" x="12" y="-13"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight">
			<Size x="46" y="46"/>
			<Anchors>
				<Anchor point="CENTER" x="-1" y="1"/>
			</Anchors>
		</HighlightTexture>
		<Scripts>
			<PostClick>
				TRP3_API.ui.misc.playUISound("gsCharacterSelection");
			</PostClick>
		</Scripts>
	</Button>

	<Button parentKey="tutorialhide" hidden="true" parent="TRP3_ToolFrame" enableMouse="true" frameStrata="DIALOG" name="$parenttutorialhide">
		<Anchors>
			<Anchor point="TOP" x="0" y="-25"/>
			<Anchor point="BOTTOM" x="0" y="25"/>
			<Anchor point="RIGHT" x="-25" y="0"/>
			<Anchor point="LEFT" x="25" y="0"/>
		</Anchors>
	</Button>

	<Frame parentKey="tutoframe" inherits="TRP3_EditorTitledFrame" hidden="true" name="TRP3_ExtendedTutorial" parent="TRP3_ToolFrame" frameStrata="TOOLTIP">
		<Size x="170" y="38"/>
		<Anchors>
			<!-- Alpha 34 / WotLK: compact navigation lives in the unused top-center
			     header strip, just above the database tab row, so it does not cover
			     the controls the tutorial is trying to explain. -->
			<Anchor point="TOP" relativePoint="TOP" x="0" y="-28"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="counter" inherits="GameFontNormal" justifyH="CENTER" name="$parentcounter">
					<Anchors><Anchor point="CENTER" x="-4" y="0"/></Anchors>
					<Color r="0.95" g="0.95" b="0.95"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>

			<!-- Kept as the internal 1.0.7 step selector, but hidden visually.
			     Previous/Next still drive SetSelectedValue(), preserving original
			     tutorial callbacks without the large Database dropdown. -->
			<Frame parentKey="step" inherits="UIDropDownMenuTemplate" enableMouse="true" hidden="true" name="$parentStep"/>

			<Button parentKey="previous" inherits="TRP3_CommonButton" name="$parentprevious">
				<Size x="36" y="20"/>
				<Anchors><Anchor point="LEFT" x="10" y="0"/></Anchors>
			</Button>

			<Button parentKey="next" inherits="TRP3_CommonButton" name="$parentnext">
				<Size x="36" y="20"/>
				<Anchors><Anchor point="RIGHT" x="-34" y="0"/></Anchors>
			</Button>

			<Button parentKey="close" inherits="UIPanelCloseButton" name="$parentclose">
				<Anchors><Anchor point="TOPRIGHT" x="0" y="0"/></Anchors>
			</Button>

		</Frames>
	</Frame>

	<Script file="tutorial.lua"/>

</Ui>